generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Escolas parceiras de Campo Mourão e região
model School {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Níveis de Escolaridade
model SchoolLevel {
  id          String   @id @default(uuid())
  year        String   // Ex: "1º ano"
  description String   // Ex: "Ensino Médio"
  createdAt   DateTime @default(now())
}

// Perguntas (Duelos)
model Question {
  id        String   @id @default(uuid())
  order     Int
  createdAt DateTime @default(now())

  options   Option[]
}

// Alternativas dos duelos
model Option {
  id         String   @id @default(uuid())
  text       String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  weight     Int      @default(1)
}

// Cursos / Perfis Profissionais
model Profile {
  id              String   @id @default(uuid())
  name            String
  description     String
  degreeType      String   @default("Bacharelado") // "Bacharelado", "Tecnologia", "Licenciatura"
  durationYears   Float    @default(5)            // ex: 5, 4, 2.5, 3
  semesters       Int      @default(10)           // ex: 10, 8, 5, 6
  shift           String   @default("Integral")   // "Integral", "Noturno"
  annualVacancies Int      @default(80)           // Número de vagas anuais
  curriculumUrl   String?                         // Link direto da matriz curricular da UTFPR
  createdAt       DateTime @default(now())

  options         Option[]
  results         TestResult[]
}

// Resultados salvos dos estudantes
model TestResult {
  id          String   @id @default(uuid())
  fullName    String
  schoolLevel String
  schoolName  String
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id])
  scores      Json
  createdAt   DateTime @default(now())
}